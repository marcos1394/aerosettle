{
  "openapi": "3.1.1",
  "info": {
    "title": "AeroSettle Marketplace API",
    "version": "0.3.3",
    "description": "Localnet read-only API. Matching is advisory; claim_work_order remains authoritative on-chain. No authentication; bind to loopback only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [],
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI document",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "RPC or matching engine failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
