  "components": {
    "schemas": {
      "Pubkey": {
        "type": "string",
        "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
        "description": "Base58-encoded Solana public key"
      },
      "Uint64": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "description": "Unsigned u64 encoded as decimal string",
        "maxLength": 20
      },
      "Agent": {
        "type": "object",
        "required": [
          "agent_account",
          "agent_id",
          "protocol_config",
          "capabilities",
          "active",
          "status"
        ],
        "properties": {
          "agent_account": {
            "$ref": "#/components/schemas/Pubkey"
          },
          "agent_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "protocol_config": {
            "$ref": "#/components/schemas/Pubkey"
          },
          "capabilities": {
            "$ref": "#/components/schemas/Uint64"
          },
          "active": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "WorkOrder": {
        "type": "object",
        "required": [
          "work_order_account",
          "protocol_config",
          "required_capabilities",
          "execution_deadline",
          "is_open",
          "status",
          "discoverable"
        ],
        "properties": {
          "work_order_account": {
            "$ref": "#/components/schemas/Pubkey"
          },
          "protocol_config": {
            "$ref": "#/components/schemas/Pubkey"
          },
          "required_capabilities": {
            "$ref": "#/components/schemas/Uint64"
          },
          "execution_deadline": {
            "type": "integer",
            "format": "int64"
          },
          "is_open": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "discoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "Page": {
        "type": "object",
        "required": [
          "limit",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "program_id": {
            "$ref": "#/components/schemas/Pubkey"
          },
          "commitment": {
            "type": "string"
          },
          "chain_now_unix": {
            "type": "integer"
          },
          "rpc_context_slots": {
            "type": "object"
          },
          "atomic_snapshot": {
            "type": "boolean"
          },
          "read_only": {
            "type": "boolean"
          },
          "matching_engine": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "AgentPage": {
        "type": "object",
        "required": [
          "data",
          "count",
          "total_count",
          "page",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "count": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "WorkOrderPage": {
        "type": "object",
        "required": [
          "data",
          "count",
          "total_count",
          "page",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkOrder"
            }
          },
          "count": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "AgentResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Agent"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "WorkOrderResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkOrder"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "MatchesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "work_order": {
                "$ref": "#/components/schemas/WorkOrder"
              },
              "eligible_agents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Agent"
                }
              },
              "evaluations": {
                "type": "array"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "MarketplaceResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "protocol_config": {
                "$ref": "#/components/schemas/Pubkey"
              },
              "paused": {
                "type": "boolean"
              },
              "agents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Agent"
                }
              },
              "work_orders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              },
              "eligible_agents_by_order": {
                "type": "object"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "EconomicMovement": {
        "type": "object",
        "required": [
          "movement_id",
          "idempotency_key",
          "agent_id",
          "agent_account",
          "owner_pubkey",
          "network",
          "genesis_hash",
          "program_id",
          "token_mint",
          "amount_base_units",
          "amount_str",
          "nature",
          "status",
          "provenance_source",
          "registered_at",
          "observed_at"
        ],
        "properties": {
          "movement_id": {
            "type": "string"
          },
          "journal_entry_id": {
            "type": [
              "string",
              "null"
            ]
          },
