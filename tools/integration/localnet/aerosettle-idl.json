          },
          {
            "name": "provided_evidence",
            "docs": [
              "EvidenceRequirement bitmask actually supplied."
            ],
            "type": "u64"
          },
          {
            "name": "execution_started_at",
            "docs": [
              "Physical execution interval."
            ],
            "type": "i64"
          },
          {
            "name": "execution_ended_at",
            "type": "i64"
          },
          {
            "name": "signature_sequence",
            "docs": [
              "Must equal AgentAccount.next_signature_sequence.",
              "",
              "Successful submission atomically consumes this sequence."
            ],
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "aerosettle::identity::AgentAccount",
      "docs": [
        "Persistent on-chain identity of one intelligent machine.",
        "",
        "PDA:",
        "[",
        "b\"agent\",",
        "protocol_config,",
        "agent_id",
        "]",
        "",
        "Notice that owner is intentionally NOT part of the PDA.",
        "",
        "This allows ownership to change later without changing the",
        "machine's canonical AeroSettle identity."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "protocol_version",
            "type": "u8"
          },
          {
            "name": "protocol_config",
            "docs": [
              "Deployment this agent belongs to."
            ],
            "type": "pubkey"
          },
          {
            "name": "agent_id",
            "docs": [
              "Stable machine/application identity."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "owner",
            "docs": [
              "Economic/legal owner of the agent."
            ],
            "type": "pubkey"
          },
          {
            "name": "signing_authority",
            "docs": [
              "Public key used by the physical device to sign execution data.",
              "",
              "It is deliberately separate from owner."
            ],
            "type": "pubkey"
          },
          {
            "name": "agent_type",
            "type": {
              "defined": {
                "name": "aerosettle::protocol::AgentType"
              }
            }
          },
          {
            "name": "capabilities",
            "docs": [
              "Capability bitset defined by AeroSettle protocol v1."
            ],
            "type": "u64"
          },
          {
            "name": "metadata_hash",
            "docs": [
              "Commitment of canonical off-chain Agent Manifest."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "aerosettle::identity::AgentStatus"
              }
            }
          },
          {
            "name": "next_signature_sequence",
            "docs": [
              "Monotonic sequence reserved for replay protection.",
              "",
              "Later instructions will derive/consume signature nonces using",
              "this sequence."
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "registered_at",
            "type": "i64"
          }
        ]
      }
