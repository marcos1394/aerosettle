{
  "name": "@aerosettle/transaction-sdk",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Localnet-only unsigned transaction builder for AeroSettle",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node examples/localnet-preview.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
